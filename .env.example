
# Database
# DB_PASSWORD подставляется в docker-compose.yml (пароль пользователя БД).
DB_PASSWORD=change_me
# Имя сервиса БД в docker compose — `db`.
# В Kubernetes используется db-service (см. k8s/backend-secret.yaml).
VA_DB_DSN=postgresql+asyncpg://vacancy_user:change_me@db:5432/vacancies

# App
VA_DEBUG=false
VA_LOG_LEVEL=INFO
# Формат логов: "json" (для сбора в Victoria Logs) или "console" (для разработки).
VA_LOG_FORMAT=json
VA_APP_TITLE=Vacancy Analyzer API
VA_APP_VERSION=0.1.0

# Миграции: в контейнере их применяет docker/entrypoint.sh,
# поэтому в lifespan приложения они выключены.
VA_RUN_MIGRATIONS=false
VA_ALEMBIC_CONFIG=/app/alembic.ini

# Connection pool
VA_DB_POOL_SIZE=10
VA_DB_MAX_OVERFLOW=20
VA_DB_POOL_TIMEOUT=30
